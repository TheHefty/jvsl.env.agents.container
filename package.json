{
  "name": "jvsl-env-agents-container",
  "displayName": "Agent Containers",
  "description": "Builds a project's dev container image and opens it in this editor, carrying the image's content so a project needs nothing else installed.",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "publisher": "thehefty",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHefty/jvsl.env.agents.container.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.18"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-vscode-remote.remote-containers"
  ],
  "activationEvents": [
    "workspaceContains:.code-server.stack.json",
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "jvsl.agentContainer.create",
        "title": "Agent Container: Create a Project\u2026"
      },
      {
        "command": "jvsl.agentContainer.open",
        "title": "Agent Container: Open a Project\u2026"
      },
      {
        "command": "jvsl.agentContainer.showDetected",
        "title": "Agent Container: Show What Was Detected"
      },
      {
        "command": "jvsl.agentContainer.configure",
        "title": "Agent Container: Configure Stacks and Limits"
      },
      {
        "command": "jvsl.agentContainer.build",
        "title": "Agent Container: Build the Image"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "jvsl.agentContainer.view",
          "name": "Agent Container"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "jvsl.agentContainer.configure",
          "when": "view == jvsl.agentContainer.view",
          "group": "navigation"
        },
        {
          "command": "jvsl.agentContainer.build",
          "when": "view == jvsl.agentContainer.view",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --outfile=dist/extension.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/*.test.ts'",
    "test:bundle": "npm run build --silent && node --test 'tools/bundle.test.ts' 'tools/vsix.test.ts'",
    "package": "vsce package --no-dependencies --out jvsl-env-agents-container.vsix",
    "test:integration": "node --test 'tools/devcontainer-up.test.ts'"
  },
  "devDependencies": {
    "@devcontainers/cli": "^0.89.0",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
