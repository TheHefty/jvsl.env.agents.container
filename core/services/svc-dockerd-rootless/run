#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# Long-running s6 service: a *rootless* Docker daemon, owned by `abc`, that
# replaces the host Docker socket this container used to bind-mount.
#
# Why this exists at all: mounting the host's /var/run/docker.sock made the
# container (and so the Claude Code agent running inside it) root-equivalent
# on the host — `docker run -v /:/host` is all it takes. Worse, it silently
# voided ai-jail's entire sandbox: an agent whose shell sees a read-only /opt
# can just `docker exec -u 0` into its own container and write there anyway.
# That was demonstrated, not theorised — see docs/OVERVIEW.md. A nested
# rootless daemon keeps everything the socket was actually *for* (compose for
# the monorepo's own services, Testcontainers) while removing the escape: this
# daemon has no access to the host's daemon, and its containers are children of
# this container, bounded by its own --memory/--cpuset limits.
#
# Written by hand rather than calling `dockerd-rootless.sh` because that script
# ships in Docker's `docker-ce-rootless-extras` package, which lives in Docker's
# own apt repo — one this template deliberately doesn't add (see
# core/Dockerfile.frag section 1). rootlesskit + slirp4netns + fuse-overlayfs
# from Ubuntu's repos are the same moving parts that script wires together.
set -euo pipefail

# The socket lives under /config/.docker (the persistent volume) rather than in
# $XDG_RUNTIME_DIR, so DOCKER_HOST can be a fixed path baked into the image
# (see core/Dockerfile.frag) instead of one containing a PUID-dependent uid.
# It also has to be somewhere the agent's ai-jail sandbox can be *granted*
# access to — connecting to a unix socket needs write permission, so a
# read-only bind wouldn't do; see docs/OVERVIEW.md for the `--rw-map` grant.
CONFIG_DIR=/config/.docker
SOCKET_DIR="$CONFIG_DIR/run"
DATA_ROOT=/config/.local/share/docker

# rootlesskit's own state is deliberately *not* on the volume: it's per-boot
# (netns handles, pid files), and stale state from a previous container start
# makes the daemon fail to come up rather than degrade.
export XDG_RUNTIME_DIR=/run/dockerd-rootless

mkdir -p "$SOCKET_DIR" "$DATA_ROOT" "$XDG_RUNTIME_DIR"

# $CONFIG_DIR is chowned separately because `mkdir -p` creates it on the way to
# $SOCKET_DIR — as root, since this service starts as root — while a `chown -R`
# aimed at the leaves never touches it. That parent is not an implementation
# detail of the socket: it *is* the default $DOCKER_CONFIG, so leaving it
# root-owned breaks `docker` for everything that needs to write there while the
# socket inside it keeps connecting fine. `docker buildx` is the concrete
# casualty — current `docker compose build` routes through Bake, buildx wants a
# state directory at $DOCKER_CONFIG/buildx, and it gets "mkdir
# /config/.docker/buildx: permission denied". Measured 2026-07-30: this was the
# only child of /config not owned by abc.
chown abc:abc "$CONFIG_DIR"
chown -R abc:abc "$SOCKET_DIR" "$DATA_ROOT" "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# /dev/fuse is what fuse-overlayfs needs, and `start` only passes it through
# when the host has it (same conditional pattern as /dev/kvm). Without it the
# daemon can't stack a copy-on-write filesystem inside an already-overlayfs
# container, so say so plainly instead of crash-looping: s6 would restart this
# service forever and bury the reason in the logs.
if [[ ! -e /dev/fuse ]]; then
    echo "**** /dev/fuse absent — nested rootless Docker disabled ****"
    echo "**** (host has no /dev/fuse, or start didn't pass --device /dev/fuse) ****"
    sleep infinity
fi

export HOME=/config

# --port-driver is what makes `docker run -p` mean anything. RootlessKit
# defaults it to `none`, and with `none` a published port is mapped inside
# RootlessKit's namespace and forwarded nowhere: `docker port` reports
# 0.0.0.0:<port> and nothing listens, even from this container. The usual source
# of the flag is `dockerd-rootless.sh`, which passes it explicitly and which this
# image cannot use (docker-ce-rootless-extras is unavailable — see
# core/Dockerfile.frag section 1), so reimplementing the invocation by hand
# dropped it. `builtin` is what that script defaults to and is the faster of the
# two; `slirp4netns` is the fallback if a workload needs the source IP preserved.
#
# --disable-host-loopback stops containers created by this daemon from reaching
# 127.0.0.1 in *this* container's network namespace (rootlesskit warns if it's
# left off). It is orthogonal to the above and stays: it blocks a nested
# container dialling back into its parent, not the parent reaching a published
# port.
exec s6-setuidgid abc \
    rootlesskit \
        --net=slirp4netns \
        --port-driver=builtin \
        --mtu=65520 \
        --disable-host-loopback \
        --copy-up=/etc \
        --copy-up=/run \
        --state-dir="$XDG_RUNTIME_DIR/rootlesskit" \
        dockerd \
            --host="unix://$SOCKET_DIR/docker.sock" \
            --data-root="$DATA_ROOT" \
            --exec-root="$XDG_RUNTIME_DIR/docker" \
            --storage-driver=fuse-overlayfs
