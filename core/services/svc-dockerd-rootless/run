#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# Long-running s6 service: a *rootless* Docker daemon, owned by `abc`, that
# replaces the host Docker socket this container used to bind-mount.
#
# Why this exists at all: mounting the host's /var/run/docker.sock made the
# container (and so the Claude Code agent running inside it) root-equivalent
# on the host — `docker run -v /:/host` is all it takes. Worse, it silently
# voided ai-jail's entire sandbox: an agent whose shell sees a read-only /opt
# can just `docker exec -u 0` into its own container and write there anyway.
# That was demonstrated, not theorised — see docs/OVERVIEW.md. A nested
# rootless daemon keeps everything the socket was actually *for* (compose for
# the monorepo's own services, Testcontainers) while removing the escape: this
# daemon has no access to the host's daemon, and its containers are children of
# this container, bounded by its own --memory/--cpuset limits.
#
# Written by hand rather than calling `dockerd-rootless.sh` because that script
# ships in Docker's `docker-ce-rootless-extras` package, which lives in Docker's
# own apt repo — one this template deliberately doesn't add (see
# core/Dockerfile.frag section 1). rootlesskit + slirp4netns + fuse-overlayfs
# from Ubuntu's repos are the same moving parts that script wires together.
set -euo pipefail

# The socket lives under /config/.docker (the persistent volume) rather than in
# $XDG_RUNTIME_DIR, so DOCKER_HOST can be a fixed path baked into the image
# (see core/Dockerfile.frag) instead of one containing a PUID-dependent uid.
# It also has to be somewhere the agent's ai-jail sandbox can be *granted*
# access to — connecting to a unix socket needs write permission, so a
# read-only bind wouldn't do; see docs/OVERVIEW.md for the `--rw-map` grant.
CONFIG_DIR="${DOCKERD_CONFIG_DIR:-/config/.docker}"
SOCKET_DIR="$CONFIG_DIR/run"
DATA_ROOT="${DOCKERD_DATA_ROOT:-/config/.local/share/docker}"
XDG_RUNTIME_DIR="${DOCKERD_RUNTIME_DIR:-/run/dockerd-rootless}"

# rootlesskit's own state is deliberately *not* on the volume: it's per-boot
# (netns handles, pid files), and stale state from a previous container start
# makes the daemon fail to come up rather than degrade.
export XDG_RUNTIME_DIR

mkdir -p "$SOCKET_DIR" "$DATA_ROOT" "$XDG_RUNTIME_DIR"

# $CONFIG_DIR is chowned separately because `mkdir -p` creates it on the way to
# $SOCKET_DIR — as root, since this service starts as root — while a `chown -R`
# aimed at the leaves never touches it. That parent is not an implementation
# detail of the socket: it *is* the default $DOCKER_CONFIG, so leaving it
# root-owned breaks `docker` for everything that needs to write there while the
# socket inside it keeps connecting fine. `docker buildx` is the concrete
# casualty — current `docker compose build` routes through Bake, buildx wants a
# state directory at $DOCKER_CONFIG/buildx, and it gets "mkdir
# /config/.docker/buildx: permission denied". Measured 2026-07-30: this was the
# only child of /config not owned by abc.
chown abc:abc "$CONFIG_DIR"
# **The data-root is chowned, never what is under it** — debt the-boots-
# recursive-chown-of-the-docker-store-loses-the-owners-images-set (gh-313).
# Under rootless Docker an image file owned by uid 1000 is stored as a subuid,
# and a recursive chown rewrote every layer in the store to abc, uid 0 in the
# user namespace: every image already there read 0:0 after the next boot,
# which looked intermittent because anything pulled since was still right.
# Measured in kotodori on 2026-11-17 and reproduced in CI by
# core/booted-docker-owners.test.sh. The daemon owns what it writes under it.
chown abc:abc "$DATA_ROOT"
chown -R abc:abc "$SOCKET_DIR" "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# /dev/fuse is what fuse-overlayfs needs, and `start` only passes it through
# when the host has it (same conditional pattern as /dev/kvm). Without it the
# daemon can't stack a copy-on-write filesystem inside an already-overlayfs
# container, so say so plainly instead of crash-looping: s6 would restart this
# service forever and bury the reason in the logs.
if [[ ! -e ${DOCKERD_FUSE_DEV:-/dev/fuse} ]]; then
    echo "**** /dev/fuse absent — nested rootless Docker disabled ****"
    echo "**** (host has no /dev/fuse, or start didn't pass --device /dev/fuse) ****"
    sleep infinity
fi

# **The storage driver is chosen once, on what the kernel allows, and the boot
# says which one the daemon runs** — debt the-nested-docker-daemon-loses-the-
# ownership-an-image-set-on-its-files (gh-313). Overlay2 keeps the owner an
# image set by construction, and kernels from 5.11 (Ubuntu's flavour from 5.4)
# let a user namespace mount it. fuse-overlayfs, the fallback, keeps them too:
# the 0:0 that opened gh-313 was not the driver but the boot's recursive chown
# of the store, above, found on 2026-11-17 — earlier measurements that held
# were taken on stores no boot had rewritten yet. The probe answer
# decides, riding whatever this container itself runs on: a mount probe,
# lower over upper in the daemon's own directories.
probe_overlay() {
    local d="$XDG_RUNTIME_DIR/overlay-probe"
    mkdir -p "$d/l" "$d/u" "$d/w" "$d/m"
    if mount -t overlay -o "lowerdir=$d/l,upperdir=$d/u,workdir=$d/w" "overlay-probe-$d/m" "$d/m" 2>/dev/null; then
        umount "$d/m" 2>/dev/null
        rm -rf "$d"
        return 0
    fi
    rm -rf "$d"
    return 1
}

DRIVER_FILE="$CONFIG_DIR/storage-driver"
if probe_overlay; then
    chosen="overlay2"
    echo "dockerd storage driver: overlay2 (the kernel lets a user namespace mount it; it keeps an image's own file owners by construction)"
else
    chosen="fuse-overlayfs"
    echo "dockerd storage driver: fuse-overlayfs (the probe could not mount overlayfs in a user namespace; it keeps image-set owners; gh-313's 0:0 was the boot's recursive chown of the store, fixed, not the driver; overlay2 stays preferred because it keeps them by construction)"
fi
written="$(cat "$DRIVER_FILE" 2>/dev/null || true)"
case "$written" in
    "$chosen") ;;
    "")
        mkdir -p "$CONFIG_DIR"
        echo "$chosen" > "$DRIVER_FILE"
        chown abc:abc "$DRIVER_FILE"
        ;;
    *)
        # The daemon refuses to start over a data-root written by another
        # driver, so the old one is moved aside whole: nothing of it is lost,
        # its images re-pull, and keeping the directory is keeping the images.
        echo "dockerd storage driver changed from $written to $chosen: no image survives a driver switch, so old graphs re-pull or re-build under the new driver; the old data-root stays at ${DATA_ROOT}.$written, and deleting that directory throws those images away."
        mv "$DATA_ROOT" "${DATA_ROOT}.$written"
        mkdir -p "$DATA_ROOT"
        echo "$chosen" > "$DRIVER_FILE"
        chown abc:abc "$DRIVER_FILE"
        ;;
esac

# **A store the old recursive chown damaged is pruned once, keeping its named
# volumes** — debt the-boots-recursive-chown-of-the-docker-store-loses-the-
# owners-images-set (gh-313). Stopping the chown, above, stops new damage; the
# layers it already rewrote read 0:0 until they are gone, and a pull answering
# "Already exists" keeps them. So a store with no marker loses everything but
# volumes/, on disk, before the daemon starts over it: a daemon finding only
# its volumes behaves as a fresh one that kept them. The marker makes it once.
# An empty store, or the fresh one a driver switch just made, is only marked.
# This cannot be undone: the images go, and are pulled or built on next use.
PRUNE_MARKER="$DATA_ROOT/.pruned-after-gh-313"
if [[ ! -e $PRUNE_MARKER ]]; then
    mapfile -t doomed < <(find "$DATA_ROOT" -mindepth 1 -maxdepth 1 ! -name volumes -printf '%f\n' | LC_ALL=C sort)
    if (( ${#doomed[@]} > 0 )); then
        for entry in "${doomed[@]}"; do rm -rf "${DATA_ROOT:?}/$entry"; done
        echo "removed from the docker store: ${doomed[*]} (images, their containers and the build cache, once; the recursive chown older images ran at boot rewrote every layer's owner to 0:0, gh-313, and a layer pulled again as Already exists kept it)"
        echo "named volumes were kept, in $DATA_ROOT/volumes; files an older boot rewrote in them may still read 0:0, and the image that owns them may need to chown them again"
    fi
    echo "store pruned after gh-313 on $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$PRUNE_MARKER"
    chown abc:abc "$PRUNE_MARKER"
fi

export HOME=/config

# --port-driver is what makes `docker run -p` mean anything. RootlessKit
# defaults it to `none`, and with `none` a published port is mapped inside
# RootlessKit's namespace and forwarded nowhere: `docker port` reports
# 0.0.0.0:<port> and nothing listens, even from this container. The usual source
# of the flag is `dockerd-rootless.sh`, which passes it explicitly and which this
# image cannot use (docker-ce-rootless-extras is unavailable — see
# core/Dockerfile.frag section 1), so reimplementing the invocation by hand
# dropped it. `builtin` is what that script defaults to and is the faster of the
# two; `slirp4netns` is the fallback if a workload needs the source IP preserved.
#
# --disable-host-loopback stops containers created by this daemon from reaching
# 127.0.0.1 in *this* container's network namespace (rootlesskit warns if it's
# left off). It is orthogonal to the above and stays: it blocks a nested
# container dialling back into its parent, not the parent reaching a published
# port.
exec s6-setuidgid abc \
    rootlesskit \
        --net=slirp4netns \
        --port-driver=builtin \
        --mtu=65520 \
        --disable-host-loopback \
        --copy-up=/etc \
        --copy-up=/run \
        --state-dir="$XDG_RUNTIME_DIR/rootlesskit" \
        dockerd \
            --host="unix://$SOCKET_DIR/docker.sock" \
            --data-root="$DATA_ROOT" \
            --exec-root="$XDG_RUNTIME_DIR/docker" \
            --storage-driver="$chosen"
