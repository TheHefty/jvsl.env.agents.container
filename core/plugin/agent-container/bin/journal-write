#!/usr/bin/env bash
# journal-write <body-file>: writes the day's journal entry (stories
# the-retro-and-its-journal, the-retro-writes-the-entry-to-the-developers-
# private-repository). The journal is the developer's: it goes to a private
# repository of theirs, named in $JOURNAL_HOME/journal.json, as
# <project>/<day>.md — **never to the project's tracker**, which travels with a
# repository that may be public. A second retro on the same day rewrites the
# same file.
#
# **Kept first, sent second.** The entry is written to the outbox,
# $JOURNAL_HOME/journal-outbox/<project>/<day>.md, before anything is sent, and
# journal-flush removes it only once GitHub has confirmed it. The last line
# says where it is: `sent: <repo>:<path>`, or `waiting in the outbox: <why>`.
# $JOURNAL_HOME is the host's ~/.claude/agent-container: the rest of /config is
# a tmpfs inside the sandbox, and an outbox there would die with the session.
#
# **The day is the local date** ($JOURNAL_TODAY, or the date of $JOURNAL_NOW in
# seconds, or now), so a retro at 22:00 at -0300 is that day's.
#
# **Refused, writing nothing**, when the body lacks a section, has them out of
# order, or leaves empty either of the two parts the agent cannot supply: the
# developer's own "What I learned" line, and "Decided alone", which says
# "Nothing." when there is nothing.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOME_DIR="${JOURNAL_HOME:-/config/.claude/agent-container}"
SECTIONS=("Discovered" "Surprised" "Went wrong" "Decided alone" "What I learned" "Left open" "Links")

file="${1:-}"
if [ -z "$file" ] || [ ! -f "$file" ]; then
    echo "usage: journal-write <body-file>  — writes today's journal entry from a Markdown body" >&2
    exit 2
fi
if [ -n "${JOURNAL_TODAY:-}" ]; then day="$JOURNAL_TODAY"
elif [ -n "${JOURNAL_NOW:-}" ]; then day="$(date -d "@$JOURNAL_NOW" +%F)"
else day="$(date +%F)"; fi

refuse() { echo "journal-write: the entry for $day was not written. $*"; exit 1; }

mapfile -t found < <(sed -n 's/^## //p' "$file")
for want in "${SECTIONS[@]}"; do
    printf '%s\n' "${found[@]}" | grep -qxF -- "$want" || refuse "It has no \"## $want\" section; every entry has all seven, in order: ${SECTIONS[*]}."
done
[ "${found[*]}" = "${SECTIONS[*]}" ] || refuse "Its sections are not in the order the planning and the study skill read: ${SECTIONS[*]}."

section() { awk -v h="## $1" '$0 == h {on = 1; next} /^## / {on = 0} on' "$file"; }
blank() { [ -z "$(section "$1" | tr -d '[:space:]')" ]; }
blank "What I learned" && refuse "\"What I learned\" is empty: that line is the developer's own, written or approved by them, and never the agent's alone."
blank "Decided alone" && refuse "\"Decided alone\" is empty: list what was chosen without asking, or write \"Nothing.\" when there was nothing."

project="$(bash "$HERE/journal-project")"
box="$HOME_DIR/journal-outbox/$project"

# Kept before anything is sent: no failure past this line can lose the entry.
mkdir -p "$box" && cp -- "$file" "$box/$day.md" || {
    echo "journal-write: the entry for $day could not be kept in $box, so nothing was written. Check that $HOME_DIR is writable."
    exit 1
}
line="$(JOURNAL_HOME="$HOME_DIR" bash "$HERE/journal-flush" | grep -F -- "$project/$day.md" | tail -n 1)"
case "$line" in
    sent:*) echo "$line" ;;
    *) echo "waiting in the outbox: ${line#waiting: $project/$day.md: }" ;;
esac
