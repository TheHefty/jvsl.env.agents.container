#!/usr/bin/env bash
# journal-write <body-file>: writes the day's journal entry (story
# the-retro-and-its-journal). One entry per working day: a chore labelled
# `journal`, closed when it is created so no planning offers it as work, titled
# `Journal <day>` and found by its metadata `day` — a title can be edited, a key
# is a key. A second retro on the same day rewrites that entry.
#
# **The day is the local date** ($JOURNAL_TODAY, or the date of $JOURNAL_NOW in
# seconds, or now), so a retro at 22:00 at -0300 is that day's and not
# tomorrow's in UTC.
#
# **Refused, writing nothing**, when the body lacks a section, has them out of
# order, or leaves empty either of the two parts the agent cannot supply: the
# developer's own "What I learned" line, and "Decided alone", which says
# "Nothing." when there is nothing. `blog-candidate` follows the body.
set -uo pipefail

BD="${REVIEW_BD:-bd}"
SECTIONS=("Discovered" "Surprised" "Went wrong" "Decided alone" "What I learned" "Left open" "Links")
if [ -n "${TRACKER_EXPORT:-}" ]; then export_of() { cat "$TRACKER_EXPORT"; }; else export_of() { bd export; }; fi

file="${1:-}"
if [ -z "$file" ] || [ ! -f "$file" ]; then
    echo "usage: journal-write <body-file>  — writes today's journal entry from a Markdown body" >&2
    exit 2
fi
if [ -n "${JOURNAL_TODAY:-}" ]; then day="$JOURNAL_TODAY"
elif [ -n "${JOURNAL_NOW:-}" ]; then day="$(date -d "@$JOURNAL_NOW" +%F)"
else day="$(date +%F)"; fi

refuse() { echo "journal-write: the entry for $day was not written. $*"; exit 1; }

mapfile -t found < <(sed -n 's/^## //p' "$file")
for want in "${SECTIONS[@]}"; do
    printf '%s\n' "${found[@]}" | grep -qxF -- "$want" || refuse "It has no \"## $want\" section; every entry has all seven, in order: ${SECTIONS[*]}."
done
[ "${found[*]}" = "${SECTIONS[*]}" ] || refuse "Its sections are not in the order the planning and the study skill read: ${SECTIONS[*]}."

section() { awk -v h="## $1" '$0 == h {on = 1; next} /^## / {on = 0} on' "$file"; }
blank() { [ -z "$(section "$1" | tr -d '[:space:]')" ]; }
blank "What I learned" && refuse "\"What I learned\" is empty: that line is the developer's own, written or approved by them, and never the agent's alone."
blank "Decided alone" && refuse "\"Decided alone\" is empty: list what was chosen without asking, or write \"Nothing.\" when there was nothing."

id="$(export_of | jq -r --arg day "$day" 'select(._type == "issue" and ((.labels // []) | index("journal")) and .metadata.day == $day) | .id' | head -n 1)"
if [ -n "$id" ]; then
    "$BD" update "$id" --body-file "$file" >/dev/null || exit 1
else
    id="$("$BD" create "Journal $day" -t chore --labels journal --body-file "$file" --metadata "{\"day\":\"$day\"}" --silent)" || exit 1
    [ -n "$id" ] || { echo "journal-write: bd created no entry for $day" >&2; exit 1; }
    "$BD" close "$id" --reason "Journal entry for $day." >/dev/null || exit 1
fi
if grep -qiE '^Blog candidate:[[:space:]]*yes' "$file"; then
    "$BD" label add "$id" blog-candidate >/dev/null || exit 1
else
    "$BD" label remove "$id" blog-candidate >/dev/null 2>&1 || true
fi
echo "$id"
