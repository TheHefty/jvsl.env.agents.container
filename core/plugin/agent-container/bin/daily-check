#!/usr/bin/env bash
# The daily's gate between the developer's choice and a claim (story the-daily).
# One line per id, `<id>: ok` or `<id>: <why not>`, and exit 1 if any is
# refused; 2 when given nothing to check.
#
# **Startable is: an agreed task, open, unblocked, with a done criterion.**
# Agreed means not deferred and not labelled `proposed` — a proposal is both
# until the developer agrees it, and either alone is still not agreed. A story
# or an epic is not startable at all: the ceremonies are the chain's calendar,
# so what has no agreed task under it goes back to refinement. A blocker counts
# while it is not closed; a parent never blocks. The criterion is the task's
# acceptance_criteria field, which refinement writes.
#
# Reads `bd export` (or $DAILY_EXPORT, for the test), in the shape bd 1.3.1
# prints and core/image.test.sh checks against the real one.
set -uo pipefail

if [ "$#" -eq 0 ]; then
    echo "usage: daily-check <id>...  — says, for each, whether the daily can start it" >&2
    exit 2
fi

if [ -n "${DAILY_EXPORT:-}" ]; then export_of() { cat "$DAILY_EXPORT"; }; else export_of() { bd export; }; fi

items="$(export_of | jq -c 'select(._type == "issue")' | jq -sc .)" || {
    echo "daily-check: could not read the tracker's export" >&2; exit 2; }

rc=0
for id in "$@"; do
    verdict="$(jq -r --arg id "$id" '
        (map({key: .id, value: .status}) | from_entries) as $status
        | (map(select(.id == $id)) | first) as $it
        | if $it == null then "not in the tracker"
          elif $it.status == "closed" then "closed"
          elif (($it.labels // []) | index("proposed")) then "a proposal, not agreed yet — refinement"
          elif $it.status == "deferred" then "deferred, not agreed for now — refinement"
          elif $it.issue_type == "epic" then "an epic, not a task — refinement breaks it into stories and tasks"
          elif $it.issue_type != "task" then "not a task: a story with no agreed task under it — refinement"
          else ([($it.dependencies // [])[] | select(.type == "blocks") | .depends_on_id
                 | select(($status[.] // "closed") != "closed")]) as $open
            | if ($open | length) > 0 then "blocked by " + ($open | join(", "))
              elif (($it.acceptance_criteria // "") | length) == 0 then "no done criterion — ask for one, and write it with bd update <id> --acceptance"
              else "ok" end
          end' <<<"$items")"
    echo "$id: $verdict"
    [ "$verdict" = ok ] || rc=1
done
exit "$rc"
