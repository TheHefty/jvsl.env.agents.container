#!/usr/bin/env bash
# journal-read: this project's journal entries, one JSON line each,
# {"day", "body", "sent"}, oldest first (story
# the-journals-readers-read-it-from-the-private-repository). The planning and
# study-sources read the journal through it, and never from the tracker.
#
# From two places: the developer's private repository named in
# $JOURNAL_HOME/journal.json, read whole with one GraphQL call, and the outbox
# journal-write keeps, whose entries are not sent yet. **On a day both hold,
# the outbox's wins**: it is the newer retro, still waiting.
#
# When the repository cannot be read, a first line {"error", "repository"}
# says why, and the outbox's entries still follow: a reader can show what is
# on this machine without taking a missing entry for a skipped retro.
# Visibility is not checked here: reading never puts the journal anywhere.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GH="${REVIEW_GH:-gh}"
HOME_DIR="${JOURNAL_HOME:-/config/.claude/agent-container}"
CONFIG="$HOME_DIR/journal.json"
project="$(bash "$HERE/journal-project")"
box="$HOME_DIR/journal-outbox/$project"

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
# Through files rather than arguments: a project's journal over years is
# megabytes, and one argument is limited to 128 KiB.
echo '[]' > "$tmp/sent"; echo '[]' > "$tmp/waiting"; echo 'null' > "$tmp/error"
fail() { jq -n --arg why "${1%.}" --arg repo "${2:-}" '{error: $why} + (if $repo == "" then {} else {repository: $repo} end)' > "$tmp/error"; }

if [ ! -f "$CONFIG" ]; then
    fail "no journal repository is named in $CONFIG"
else
    repo="$(jq -r '.repository // empty' "$CONFIG" 2>/dev/null)"
    if ! [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
        fail "$CONFIG does not name a repository as \"<owner>/<repo>\""
    elif "$GH" api graphql -f query='query($o: String!, $r: String!, $e: String!) {
            repository(owner: $o, name: $r) { object(expression: $e) {
              ... on Tree { entries { name object { ... on Blob { text } } } } } } }' \
            -f "o=${repo%%/*}" -f "r=${repo#*/}" -f "e=HEAD:$project" > "$tmp/answer" 2> "$tmp/err"; then
        # No folder yet, or an empty repository, answers a null object: no entries.
        jq '[.data.repository.object.entries // [] | .[] | select(.name | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.md$"))
             | {day: .name[0:10], body: (.object.text // ""), sent: true}]' "$tmp/answer" > "$tmp/sent"
    else
        fail "$(tail -n 1 "$tmp/err" | sed 's/^gh: //')" "$repo"
    fi
fi

if [ -d "$box" ]; then
    for f in "$box"/????-??-??.md; do
        [ -f "$f" ] || continue
        jq -n --arg day "$(basename "$f" .md)" --rawfile body "$f" '{day: $day, body: $body, sent: false}'
    done | jq -s . > "$tmp/waiting"
fi

jq -nc --slurpfile sent "$tmp/sent" --slurpfile waiting "$tmp/waiting" --slurpfile error "$tmp/error" '
    ($error[0] // empty),
    (reduce ($sent[0][], $waiting[0][]) as $e ({}; .[$e.day] = $e) | to_entries | sort_by(.key) | .[].value)'
