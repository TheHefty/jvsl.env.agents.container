{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheHefty/jvsl.env.agents.container/core/plugin/agent-container/study/practice.schema.json",
  "title": "A study topic's practice set",
  "description": "docs/study/<slug>/practice.json: the exercises and questions, with their answers, that the Study view shows one at a time and hides the answer of until the developer has attempted it.",
  "type": "object",
  "required": [
    "topic",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The topic's slug, which is also its folder's name."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "level",
          "prompt",
          "answer",
          "variation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "exercise",
              "question"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "variation": {
            "type": "boolean",
            "description": "A \"what if…?\" question: the same mechanism under a changed condition."
          },
          "angle": {
            "const": "when-not-to-use",
            "description": "Marks the question about when the solution is the wrong one."
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "exercise"
              }
            }
          },
          "minContains": 2,
          "maxContains": 4
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "question"
              }
            }
          },
          "minContains": 5,
          "maxContains": 8
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "variation"
            ],
            "properties": {
              "variation": {
                "const": true
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "angle"
            ],
            "properties": {
              "angle": {
                "const": "when-not-to-use"
              }
            }
          },
          "minContains": 1
        }
      ]
    }
  }
}
