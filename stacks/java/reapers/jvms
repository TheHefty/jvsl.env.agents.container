#!/usr/bin/env bash
# Reaper kind (see core/services/svc-reaper/run): stops the two JVMs that
# outlive their owner here (#187), and no other.
#
# **A Kotlin compile daemon with no Gradle daemon left.** Measured on
# 2026-10-21: when a Gradle daemon is SIGKILLed — as the OOM killer does — its
# Kotlin daemon is re-parented to PID 1 and lives out its idle shutdown. The
# java stack cuts that to ten minutes; this is the backstop. A Kotlin daemon
# can be shared between Gradle daemons, so any live Gradle daemon — the agent's
# in its sandbox included, which is visible from here — keeps every one.
#
# **A Java language server with no editor above it.** Its parent is the
# editor's extension host, a node process; when the window goes away it is
# re-parented to the container's init. So it is orphaned when no node process
# is in its ancestor chain. VS Code's --type=extensionHost marker is not used
# on purpose: if it changed, every live language server would look orphaned
# and lose a person their editor's Java support every five minutes.
#
# Any other JVM, orphaned or not, is not this kind's business: an application
# somebody left running with `&` has PPID 1 too.
set -uo pipefail

PROC="${REAPER_PROC:-/proc}"
ME="${REAPER_UID:-$(id -u)}"
# shellcheck source=core/reapers/reaper-lib.sh
. "${REAPER_LIB:-/usr/local/lib/jvsl/reaper-lib.sh}"

KOTLIN=org.jetbrains.kotlin.daemon.KotlinCompileDaemon
GRADLE=org.gradle.launcher.daemon.bootstrap.GradleDaemon

declare -A ppid_of=() comm_of=()
gradle_alive=""
candidates=()
for dir in "$PROC"/[0-9]*; do
    pid="${dir##*/}"
    stat="$(cat "$dir/stat" 2>/dev/null)" || continue
    comm="${stat#*(}"; comm="${comm%)*}"
    ppid_of[$pid]="$(reaper_field "$stat" 2)"
    comm_of[$pid]="$comm"
    cmd="$(tr '\0' '\n' < "$dir/cmdline" 2>/dev/null)" || continue
    grep -qx "$GRADLE" <<<"$cmd" && gradle_alive=yes
    [ "$(awk '/^Uid:/ {print $2}' "$dir/status" 2>/dev/null)" = "$ME" ] || continue
    if grep -qx "$KOTLIN" <<<"$cmd"; then
        candidates+=("$pid $(reaper_field "$stat" 20) kotlin")
    elif grep -q 'org\.eclipse\.equinox\.launcher' <<<"$cmd" && grep -qE 'jdt\.ls|redhat\.java' <<<"$cmd"; then
        candidates+=("$pid $(reaper_field "$stat" 20) jdtls")
    fi
done

# True when a node process is somewhere between pid and init.
editor_above() {
    local p="${ppid_of[$1]:-0}" hops=0
    while [ "$p" -gt 1 ] && [ "$hops" -lt 64 ]; do
        [ "${comm_of[$p]:-}" = node ] && return 0
        p="${ppid_of[$p]:-0}"
        hops=$((hops + 1))
    done
    return 1
}
rss() { awk '/^VmRSS:/ {printf "%dM", $2 / 1024}' "$PROC/$1/status" 2>/dev/null; }

# A seam for the test, to change /proc between the scan and the signals.
[ -n "${REAPER_BETWEEN:-}" ] && eval "$REAPER_BETWEEN"

for c in "${candidates[@]}"; do
    read -r pid start what <<<"$c"
    case "$what" in
        kotlin)
            [ -z "$gradle_alive" ] || continue
            mem="$(rss "$pid")"
            reaper_stop "$pid" "$start" || continue
            echo "KotlinCompileDaemon pid $pid (${mem:-?}, no Gradle daemon is left)" ;;
        jdtls)
            editor_above "$pid" && continue
            mem="$(rss "$pid")"
            reaper_stop "$pid" "$start" || continue
            echo "Java language server pid $pid (${mem:-?}, its editor is gone)" ;;
    esac
done
exit 0
